class FeeAccount {

    double totalFee;

    FeeAccount(double totalFee) {
        this.totalFee = totalFee;
    }

    // Cannot be overridden
    final double calculateLateFee(int daysLate) {
        return totalFee * daysLate / 100.0;
    }

    // Cannot be overridden
    final void printSummary(int daysLate) {

        if (daysLate <= 0) {
            System.out.println("On time, no late fee");
        } else {
            double lateFee = calculateLateFee(daysLate);

            System.out.println(
                "Total Fee: Rs " + totalFee +
                " | Late Fee: Rs " + lateFee
            );
        }
    }
}

public class Main {
    public static void main(String[] args) {

        String[] regNos = {
            "RA001",
            "RA002",
            "RA003",
            "RA004"
        };

        double[] totalFees = {
            200000,
            150000,
            180000,
            220000
        };

        int[] daysLate = {
            10,
            0,
            -2,
            5
        };

        // Single pass
        for (int i = 0; i < regNos.length; i++) {

            if (daysLate[i] <= 0) {
                System.out.println(
                    regNos[i] + " - On time, no late fee"
                );
            } else {

                FeeAccount account =
                    new FeeAccount(totalFees[i]);

                double lateFee =
                    account.calculateLateFee(daysLate[i]);

                System.out.println(
                    regNos[i] +
                    " | Total Fee: Rs " + totalFees[i] +
                    " | Late Fee: Rs " + lateFee
                );
            }
        }
    }
}
