import java.time.LocalDate;

abstract class Employee {
    protected String name;

    Employee(String name) {
        this.name = name;
    }

    public String getName() {
        return name;
    }

    public abstract boolean isLeaveAllowed(int days);
}

class FullTimeEmployee extends Employee {
    FullTimeEmployee(String name) {
        super(name);
    }

    public boolean isLeaveAllowed(int days) {
        return days > 0 && days <= 30;
    }
}

class PartTimeEmployee extends Employee {
    PartTimeEmployee(String name) {
        super(name);
    }

    public boolean isLeaveAllowed(int days) {
        return days > 0 && days <= 10;
    }
}

class LeaveRequest {
    private Employee employee;
    private LocalDate start;
    private LocalDate end;
    private String status = "Pending";

    LeaveRequest(Employee employee, LocalDate start, LocalDate end) {
        if (start == null || end == null || end.isBefore(start)) {
            throw new IllegalArgumentException("Invalid leave dates");
        }

        this.employee = employee;
        this.start = start;
        this.end = end;
    }

    public boolean submit() {
        int days = (int) (end.toEpochDay() - start.toEpochDay()) + 1;

        if (!employee.isLeaveAllowed(days)) {
            System.out.println("Leave policy does not allow this request.");
            return false;
        }

        System.out.println("Leave request submitted for " +
            employee.getName() + " (" + start + " to " + end + ").");
        System.out.println("Status: " + status);
        return true;
    }

    public void review(String reviewer, boolean approved) {
        if (!status.equals("Pending")) {
            System.out.println("Request has already been reviewed.");
            return;
        }

        status = approved ? "Approved" : "Rejected";

        System.out.println(employee.getName() + "'s leave request (" +
            start + " to " + end + ") " + status.toLowerCase() +
            " by " + reviewer + ".");
        System.out.println("Status: " + status);
    }

    public void changeStatus(String newStatus) {
        if (!status.equals("Pending") || newStatus.equals("Pending")) {
            System.out.println("Cannot change leave request status from " +
                status + " to " + newStatus + ".");
            return;
        }

        if (newStatus.equals("Approved") || newStatus.equals("Rejected")) {
            status = newStatus;
        } else {
            System.out.println("Invalid status.");
        }
    }

    public String getStatus() {
        return status;
    }
}

public class Main {
    public static void main(String[] args) {
        Employee john = new FullTimeEmployee("John");
        Employee jane = new PartTimeEmployee("Jane");

        LeaveRequest r1 = new LeaveRequest(
            john, LocalDate.of(2027, 1, 1),
            LocalDate.of(2027, 1, 5));

        if (r1.submit()) {
            r1.review("Alice", true);
        }
        r1.changeStatus("Pending");

        LeaveRequest r2 = new LeaveRequest(
            jane, LocalDate.of(2027, 2, 10),
            LocalDate.of(2027, 2, 11));

        if (r2.submit()) {
            r2.review("Bob", false);
        }
    }
}
