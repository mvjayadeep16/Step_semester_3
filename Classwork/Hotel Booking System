import java.time.LocalDate;
import java.util.*;

abstract class Room {
    int number;
    double rate;

    Room(int number, double rate) {
        this.number = number;
        this.rate = rate;
    }

    abstract double calculatePrice(long nights);
}

class StandardRoom extends Room {
    StandardRoom(int number, double rate) {
        super(number, rate);
    }

    double calculatePrice(long nights) {
        return rate * nights;
    }
}

class DeluxeRoom extends Room {
    DeluxeRoom(int number, double rate) {
        super(number, rate);
    }

    double calculatePrice(long nights) {
        return rate * nights * 1.25;
    }
}

class Customer {
    String name;

    Customer(String name) {
        this.name = name;
    }
}

class Reservation {
    Customer customer;
    Room room;
    LocalDate start, end, cancellationDeadline;
    boolean active = true;

    Reservation(Customer customer, Room room,
                LocalDate start, LocalDate end,
                LocalDate cancellationDeadline) {
        this.customer = customer;
        this.room = room;
        this.start = start;
        this.end = end;
        this.cancellationDeadline = cancellationDeadline;
    }

    boolean overlaps(LocalDate from, LocalDate to) {
        return active && from.isBefore(end) && start.isBefore(to);
    }

    void cancel(LocalDate today) {
        if (!active) {
            System.out.println("Reservation is already cancelled.");
        } else if (today.isAfter(cancellationDeadline)) {
            System.out.println("Cancellation deadline has passed.");
        } else {
            active = false;
            System.out.println("Reservation for " + customer.name +
                ", Room " + room.number + " cancelled successfully.");
        }
    }
}

class HotelBookingSystem {
    List<Reservation> reservations = new ArrayList<>();

    boolean isAvailable(Room room, LocalDate start, LocalDate end) {
        if (start == null || end == null ||
            !start.isBefore(end)) {
            return false;
        }

        for (Reservation r : reservations) {
            if (r.room == room && r.overlaps(start, end)) {
                return false;
            }
        }
        return true;
    }

    Reservation book(Customer customer, Room room,
                     LocalDate start, LocalDate end,
                     LocalDate deadline) {
        if (!isAvailable(room, start, end)) {
            System.out.println("Room " + room.number +
                " is not available from " + start + " to " + end);
            return null;
        }

        Reservation r = new Reservation(
            customer, room, start, end, deadline);
        reservations.add(r);

        long nights = java.time.temporal.ChronoUnit.DAYS
            .between(start, end);

        System.out.println("Reservation confirmed for " +
            customer.name + ", Room " + room.number);
        System.out.println("Price: $" + room.calculatePrice(nights));

        return r;
    }
}

public class Main {
    public static void main(String[] args) {
        HotelBookingSystem hotel = new HotelBookingSystem();

        Room standard = new StandardRoom(101, 100);
        Room deluxe = new DeluxeRoom(201, 160);

        Customer a = new Customer("Customer A");
        Customer b = new Customer("Customer B");
        Customer c = new Customer("Customer C");

        LocalDate start = LocalDate.of(2027, 1, 1);
        LocalDate end = LocalDate.of(2027, 1, 5);

        System.out.println(hotel.isAvailable(standard, start, end)
            ? "Standard Room 101 is available."
            : "Standard Room 101 is not available.");

        Reservation r = hotel.book(a, standard, start, end,
            LocalDate.of(2026, 12, 25));

        hotel.book(b, standard,
            LocalDate.of(2027, 1, 3),
            LocalDate.of(2027, 1, 7),
            LocalDate.of(2026, 12, 28));

        if (r != null) {
            r.cancel(LocalDate.of(2026, 12, 20));
        }

        hotel.book(c, deluxe,
            LocalDate.of(2027, 2, 10),
            LocalDate.of(2027, 2, 12),
            LocalDate.of(2027, 2, 1));
    }
}
